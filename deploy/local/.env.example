# Copy to deploy/local/.env and replace all local development secrets.
POSTGRES_USER=shotdesigner
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_DB=production
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=replace_with_a_unique_local_minio_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_unique_local_keycloak_password
PRODUCTION_INTERNAL_TOKEN=replace_with_a_unique_internal_token
WORKSPACE_INTERNAL_TOKEN=replace_with_a_unique_workspace_token
ASSET_INTERNAL_TOKEN=replace_with_a_unique_asset_token
BFF_DEV_WORKSPACE_ID=ws_dev
BFF_DEV_ACTOR_ID=user_dev

# Optional host ports (all published ports are loopback-only).
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SCHEMA_REGISTRY_PORT=8082
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
KEYCLOAK_PORT=8083
WEB_PORT=5173
