# /etc/shotdesigner/env —— Shotdesigner 生产环境变量（root:root 0600，勿入 git）
#
# 6 个 systemd 单元共用这一份 EnvironmentFile：
# 每个服务只读取自己前缀的变量，未被读取的变量对它无副作用。
#
# 生成方式见 deploy/server/install.sh；修改后需要重启对应服务：
#   systemctl restart shotdesigner@web-bff
#
# 所有 LISTEN_ADDR 都绑定 127.0.0.1：外部只能经 nginx(443) → web-bff(8080) 进入。

# ── 数据库 ───────────────────────────────────────────────────────────────
# 分库：production / workspace / asset / execution 四个库，同一 PostgreSQL 实例
DB_USER=shotdesigner
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

WORKSPACE_DATABASE_URL=postgres://shotdesigner:CHANGE_ME@localhost:5432/workspace?sslmode=disable
PRODUCTION_DATABASE_URL=postgres://shotdesigner:CHANGE_ME@localhost:5432/production?sslmode=disable
ASSET_DATABASE_URL=postgres://shotdesigner:CHANGE_ME@localhost:5432/asset?sslmode=disable
EXECUTION_DATABASE_URL=postgres://shotdesigner:CHANGE_ME@localhost:5432/execution?sslmode=disable
OUTBOX_DATABASE_URL=postgres://shotdesigner:CHANGE_ME@localhost:5432/production?sslmode=disable

# ── 服务间内部令牌（BFF 注入下游，必须与其他服务一致）───────────────────
WORKSPACE_INTERNAL_TOKEN=CHANGE_ME
PRODUCTION_INTERNAL_TOKEN=CHANGE_ME
ASSET_INTERNAL_TOKEN=CHANGE_ME
EXECUTION_INTERNAL_TOKEN=CHANGE_ME

# ── workspace：凭据加密密钥（一旦有数据不可更换，否则历史凭据无法解密）──
WORKSPACE_CRED_KEY=CHANGE_ME

# ── 监听地址（仅回环）───────────────────────────────────────────────────
WORKSPACE_LISTEN_ADDR=127.0.0.1:8082
PRODUCTION_LISTEN_ADDR=127.0.0.1:8081
ASSET_LISTEN_ADDR=127.0.0.1:8084
EXECUTION_LISTEN_ADDR=127.0.0.1:8085
BFF_LISTEN_ADDR=127.0.0.1:8080

# ── asset：对象存储（MinIO 容器）─────────────────────────────────────────
ASSET_S3_ENDPOINT=localhost:9000
ASSET_S3_BUCKET=assets
ASSET_S3_ACCESS_KEY=CHANGE_ME
ASSET_S3_SECRET_KEY=CHANGE_ME
ASSET_MAX_BYTES=104857600

# ── web-bff：下游地址 ───────────────────────────────────────────────────
BFF_WORKSPACE_URL=http://localhost:8082
BFF_PRODUCTION_URL=http://localhost:8081
BFF_ASSET_URL=http://localhost:8084
BFF_EXECUTION_URL=http://localhost:8085

# ── web-bff：本地开发身份（生产 OIDC 未接入前的固定身份）─────────────────
BFF_DEV_WORKSPACE_ID=ws_dev
BFF_DEV_ACTOR_ID=user_dev

# ── outbox-relay ────────────────────────────────────────────────────────
OUTBOX_EXECUTION_URL=http://localhost:8085
OUTBOX_EXECUTION_TOKEN=CHANGE_ME
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_POLL_SECONDS=2
