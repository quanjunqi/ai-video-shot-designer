# =============================================================================
# 漫剧导演工坊 — 环境变量权威清单
# =============================================================================
# 用法：
#   cp .env.example .env.local      # .env.local 已被 .gitignore 忽略
#   set -a && . ./.env.local && set +a
#
# 约定：
#   - 本文件是各服务环境变量的**唯一权威清单**，与代码中的 os.Getenv 保持一致。
#     新增环境变量必须同时更新本文件，并在 PR 中说明。
#   - 所有变量通过环境变量注入，禁止硬编码（AGENTS.md §4.2）。
#   - 下列为**本地开发默认值**，禁止用于生产；生产由 KMS/Secret Manager 注入。
#   - **运行模式**：本文件面向「直接在本机跑服务二进制」（AGENTS.md §8.1），
#     此时服务绑定宿主端口 18081/18082/18084/8085/8080。
#     用 Docker Compose 跑（deploy/local/）时服务在容器内监听 8081/8082/8084/8085/8080，
#     由 compose.yaml 覆盖这些值 —— 两种模式端口不同，详见
#     docs/architecture/05-deployment.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 本地基础设施（deploy/local Compose）
# -----------------------------------------------------------------------------
POSTGRES_USER=shotdesigner
POSTGRES_PASSWORD=local-postgres-password-2026
POSTGRES_DB=production
POSTGRES_PORT=5432
REDIS_PORT=6379

# 服务间内部调用令牌（本地固定值；生产必须轮换为强随机值）
PRODUCTION_INTERNAL_TOKEN=local-internal-token-2026
WORKSPACE_INTERNAL_TOKEN=local-workspace-token-2026
EXECUTION_INTERNAL_TOKEN=local-execution-token-2026
ASSET_INTERNAL_TOKEN=local-asset-token-2026

# -----------------------------------------------------------------------------
# workspace (18082) — 租户/成员/授权/渠道凭据
# -----------------------------------------------------------------------------
WORKSPACE_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/workspace?sslmode=disable
WORKSPACE_INTERNAL_TOKEN=local-workspace-token-2026
WORKSPACE_LISTEN_ADDR=0.0.0.0:18082
# 渠道凭据加密密钥（生产必须由 KMS/Secret Manager 提供，且不得入库）
WORKSPACE_CRED_KEY=local-cred-key-32-bytes-change-me

# -----------------------------------------------------------------------------
# production (18081) — 项目/剧集/分镜/模型目录(Catalog)
# -----------------------------------------------------------------------------
PRODUCTION_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/production?sslmode=disable
# 集成测试专用库（compose `test` profile）
PRODUCTION_TEST_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/production_test?sslmode=disable
PRODUCTION_INTERNAL_TOKEN=local-internal-token-2026
PRODUCTION_LISTEN_ADDR=0.0.0.0:18081

# -----------------------------------------------------------------------------
# execution (8085) — Job 调度/模型网关/审计日志
# -----------------------------------------------------------------------------
EXECUTION_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/execution?sslmode=disable
EXECUTION_TEST_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/execution_test?sslmode=disable
EXECUTION_INTERNAL_TOKEN=local-execution-token-2026
EXECUTION_LISTEN_ADDR=0.0.0.0:8085
# 下游依赖地址（execution 取 Catalog 快照 / reveal 渠道凭据）
EXECUTION_PRODUCTION_URL=http://127.0.0.1:18081
EXECUTION_WORKSPACE_URL=http://127.0.0.1:18082

# -----------------------------------------------------------------------------
# asset (18084) — 资产上传/媒体校验
# -----------------------------------------------------------------------------
ASSET_DATABASE_URL=postgres://shotdesigner:local-postgres-password-2026@127.0.0.1:5432/asset?sslmode=disable
ASSET_INTERNAL_TOKEN=local-asset-token-2026
ASSET_LISTEN_ADDR=0.0.0.0:18084
# 单次上传体积上限（字节）
ASSET_MAX_BYTES=104857600
# 未配置对象存储时置 1，让 asset 以「存储不可用」降级运行而非启动失败
ASSET_UNAVAILABLE=0
# S3 兼容对象存储（deploy/local 的 `platform` profile 提供 MinIO）
ASSET_S3_ENDPOINT=http://127.0.0.1:9000
ASSET_S3_BUCKET=shotdesigner-assets
ASSET_S3_ACCESS_KEY=minioadmin
ASSET_S3_SECRET_KEY=local-minio-password-2026

# -----------------------------------------------------------------------------
# web-bff (8080) — 前端唯一入口（无状态聚合层，无自有数据库）
# -----------------------------------------------------------------------------
BFF_LISTEN_ADDR=0.0.0.0:8080
BFF_WORKSPACE_URL=http://127.0.0.1:18082
BFF_PRODUCTION_URL=http://127.0.0.1:18081
BFF_EXECUTION_URL=http://127.0.0.1:8085
BFF_ASSET_URL=http://127.0.0.1:18084
# 仅本地开发：注入固定身份；生产必须改为 OIDC 校验后的真实身份
BFF_DEV_WORKSPACE_ID=ws_dev
BFF_DEV_ACTOR_ID=actor_local
