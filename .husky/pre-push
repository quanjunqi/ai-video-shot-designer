#!/usr/bin/env bash
# pre-push：把"推错东西"变成【不可能】，而不是靠记得住。
#
# 为什么需要它（本项目真实事故）：
#   我在【主 checkout】里执行 `git rev-parse HEAD` / `git push`，而我的提交在某个 worktree 里
#   ⇒ HEAD 解析成了 develop ⇒ 把 develop 的 SHA 强推到了特性分支上：
#     分支内容被清空、PR 变成"与基线无差异"（422），只有靠本地还留着提交才救回来。
#   ⇒ 那次【绕过了一切脚本】（手写 git 命令）。唯一的拦截点就是 git 自己的钩子。
#
# 本钩子拦三类（每一类都是本项目真实发生过或极易发生的）：
#   A 回退推送：远端当前 SHA 不是本地 SHA 的祖先 ⇒ 会丢提交，默认拒绝
#   B 直推受保护分支 develop / master ⇒ 违反 `.agents/skills/pr-workflow/SKILL.md`（禁止直推 master）与 `AGENTS.md`「分支与提交」，默认拒绝
#   C 空分支：与基线相比没有任何新提交 ⇒ 多半是推错了目录/分支，拒绝
#
# 明确覆盖（表示"我知道我在做什么"）：
#   ALLOW_REWRITE=1 git push --force-with-lease …      放行 A
#   ALLOW_PUSH_PROTECTED=1 git push origin develop     放行 B
#   ALLOW_EMPTY_BRANCH=1 git push …                    放行 C
set -uo pipefail

ZERO=0000000000000000000000000000000000000000
fail=0

refuse() { printf '❌ pre-push 拒绝：%s\n' "$1" >&2; fail=1; }
hint()   { printf '   %s\n' "$1" >&2; }

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac
  branch="${remote_ref#refs/heads/}"
  [ "$local_sha" = "$ZERO" ] && continue          # 删除分支：不拦

  # ---- B 受保护分支 -------------------------------------------------------
  case "$branch" in
    develop|master)
      if [ "${ALLOW_PUSH_PROTECTED:-0}" != "1" ]; then
        refuse "直接推送受保护分支 ${branch}（`AGENTS.md`「分支与提交」：改动须经 PR 合入）"
        hint "若确属人工发布流程，请显式：ALLOW_PUSH_PROTECTED=1 git push …"
      fi
      ;;
  esac

  # ---- A 回退推送（会丢提交）---------------------------------------------
  if [ "$remote_sha" != "$ZERO" ] && [ "$remote_sha" != "$local_sha" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      if [ "${ALLOW_REWRITE:-0}" != "1" ]; then
        refuse "回退推送：远端 ${remote_sha:0:7} 不是本地 ${local_sha:0:7} 的祖先 ⇒ 会丢提交"
        hint "这通常意味着【你在错误的目录里推送】（本地 HEAD 不是你以为的分支）"
        hint "若确属有意改写，请显式：ALLOW_REWRITE=1 git push --force-with-lease …"
      fi
    fi
  fi

  # ---- C 空分支（与基线相比没有新提交）-----------------------------------
  case "$branch" in
    feature/*|feat/*|fix/*|docs/*|chore/*|test/*|ci/*|refactor/*|perf/*) base="origin/develop" ;;
    hotfix/*) base="origin/master" ;;
    *) base="" ;;
  esac
  if [ -n "$base" ] && [ "${ALLOW_EMPTY_BRANCH:-0}" != "1" ]; then
    if base_sha="$(git rev-parse --verify --quiet "$base" 2>/dev/null)" && [ -n "$base_sha" ]; then
      if [ "$local_sha" = "$base_sha" ]; then
        refuse "分支 $branch 与基线 $base 的 SHA 相同 ⇒ 没有任何新提交（推错目录/分支？）"
        hint "判据：git rev-list --count $base..$local_sha 应为 >0"
      fi
    fi
  fi
done

if [ "$fail" -ne 0 ]; then
  printf '\n   本次推送已中止（未向远端写入任何东西）。\n' >&2
  exit 1
fi
exit 0
