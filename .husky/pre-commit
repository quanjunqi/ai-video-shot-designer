#!/usr/bin/env sh
# 提交前门禁：**按暂存内容选择要跑的门**，而不是"一律跑前端"。
#
# 为什么改（本仓库真实发生两次）：
#   旧实现无论提交什么文件都执行 `npm run gate`，而它需要 apps/web/node_modules。
#   于是一个【纯 Go 改动】的提交会因为 `tsc: command not found` 而失败 ——
#   门禁报的像是"前端坏了"，而实际前端一行未改，只是 worktree 里没装依赖。
#   两次都被迫先软链 node_modules 才能提交 ⇒ "与改动无关的门在拦人"。
#
# 现在的规则（按暂存文件判定）：
#   · 暂存含 apps/web/** → 跑前端门禁；缺 node_modules 时给【可行动的】提示
#   · 暂存含 **/*.go      → 只跑 gofmt（快）；这正是 CI 六道门里真实拦过的那道
#   · 两者都没有          → 跳过并说明
#
# 注意：pre-commit 只是【快速自检】，不是质量保证；真正的门是 CI。
# 完整的本地六道门（含覆盖率棘轮）：bash scripts/preflight.sh
# 跳过方式（仅紧急场景）：SKIP_GATE=1 git commit
set -u

if [ "${SKIP_GATE:-}" = "1" ]; then
  echo "[pre-commit] SKIP_GATE=1，跳过质量门禁"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -z "$STAGED" ]; then
  echo "[pre-commit] 无暂存文件，跳过"
  exit 0
fi

want_frontend=0
go_list=""
shell_list=""
for f in $STAGED; do
  case "$f" in apps/web/*) want_frontend=1 ;; esac
  case "$f" in *.go) go_list="$go_list$f
" ;; esac
  # 脚本改动也要过一道门：本项目三次因 `$VAR` 紧跟非 ASCII 出事，
  # 而此前改脚本时**本地没有任何门**（门 0 只存在于 preflight.sh）—— 已真实撞到。
  case "$f" in scripts/*.sh|.husky/*) shell_list="$shell_list$f
" ;; esac
done

status=0

if [ -n "$go_list" ]; then
  if command -v gofmt >/dev/null 2>&1; then
    echo "[pre-commit] Go 格式检查（gofmt）…"
    unformatted="$(cd "$ROOT" && printf '%s' "$go_list" | xargs gofmt -l 2>/dev/null)"
    if [ -n "$unformatted" ]; then
      echo "[pre-commit] ✗ 以下 Go 文件未格式化（CI 会因此失败）："
      printf '%s\n' "$unformatted" | sed 's/^/    /'
      echo "[pre-commit]   修复：gofmt -w <上述文件>"
      status=1
    else
      echo "[pre-commit] ✓ gofmt 通过"
    fi
  else
    echo "[pre-commit] ⚠️  gofmt 不在 PATH ⇒ 这道门【未验证】（CI 会跑）"
  fi
fi

if [ -n "$shell_list" ]; then
  echo "[pre-commit] 脚本自检（\${VAR} 与非 ASCII 相邻）…"
  if ( cd "$ROOT" && printf '%s' "$shell_list" | tr '\n' ' ' | xargs bash "$ROOT/scripts/check-shell-vars.sh" ); then
    echo "[pre-commit] ✓ 脚本自检通过"
  else
    status=1
  fi
fi

if [ "$want_frontend" = "1" ]; then
  if [ ! -d "$ROOT/apps/web/node_modules" ]; then
    echo "[pre-commit] ✗ 暂存里有 apps/web 改动，但 apps/web/node_modules 不存在。"
    echo "[pre-commit]   修复：cd apps/web && npm install"
    echo "[pre-commit]   （worktree 里可软链主目录：ln -sfn <主目录>/apps/web/node_modules apps/web/node_modules）"
    status=1
  else
    echo "[pre-commit] 运行前端质量门禁（npm run gate）…"
    ( cd "$ROOT/apps/web" && npm run gate ) || status=1
    if [ "$status" = "0" ]; then echo "[pre-commit] ✓ 前端门禁通过"; else echo "[pre-commit] ✗ 前端门禁未通过"; fi
  fi
fi

if [ -z "$go_list" ] && [ "$want_frontend" = "0" ] && [ -z "$shell_list" ]; then
  echo "[pre-commit] 暂存内容不涉及 Go / apps/web / 脚本，跳过门禁"
fi

if [ "$status" != "0" ]; then
  echo "[pre-commit] ✗ 未通过：请修复后重新提交（或 SKIP_GATE=1 紧急跳过）"
  echo "[pre-commit]   完整六道门（含覆盖率棘轮）：bash scripts/preflight.sh"
  exit "$status"
fi
echo "[pre-commit] ✓ 通过（完整门禁见 scripts/preflight.sh）"
exit 0
